% main_script_de_survivor_median.m
% DIFFERENTIAL EVOLUTION OPTIMIZATION.
%
% This version keeps the same model, same cost_function_2 objective, same
% additive parameter changes, and same PE(0) initial-condition fitting that
% were used in main_script_bayesopt_survivor_median.m.
%
% Main changes:
%   1) Replaces bayesopt with Differential Evolution (DE/rand/1/bin).
%   2) Uses parfor to evaluate the DE trial population in parallel.
%   3) Saves new_pars and new_Init to fit_de_results.mat.
%   4) Can continue from a previous DE fit or, optionally, from the old
%      fit_bayesopt_results.mat file.
%
% Required files in the same folder:
%   Survivor_Data.csv
%   model.m
%   cost_function_2.m
%   load_pars_Init_Copeland_Edited.m

close all;
clear;
clc;
totalTimer = tic;

%% ================= USER SETTINGS =================
csvFile = 'Survivor_Data.csv';
matFile = 'fit_results.mat';

% TRUE  = if matFile exists, start DE from saved new_pars/new_Init
% FALSE = ignore matFile and start from load_pars_Init_Copeland_Edited baseline
LOAD_EXISTING_MAT_AS_START = true;

% If no DE result exists yet, this lets you start from the previous BayesOpt fit.
% Set false if you only want to start from the original baseline.
ALLOW_BAYESOPT_MAT_AS_FALLBACK_START = false;
fallbackBayesoptMatFile = 'fit_results.mat';

% If TRUE, make a timestamped backup before overwriting matFile.
BACKUP_EXISTING_MAT_BEFORE_SAVE = true;

runningTime = 700;
tspan = 0:0.1:runningTime;

useLogFit = false;

% Additive change bound, expressed as a percent of each starting value.
% Example: 20 means each fitted value can change by +/- 0.20*abs(starting value).
% The code applies this as: new_value = starting_value + delta.
% It does NOT use new_value = starting_value*(1 + theta).
perturbPercent = 20;

% Differential Evolution settings.
% DE evaluates a full trial population each generation, so parallel helps a lot.
maxObjectiveEvaluations = 20000;
populationSize = [];      % [] = automatic, max(40, 4*nfit)
mutationFactor = 0.80;    % F in DE. Common range: 0.5 to 0.9
crossoverRate = 0.80;     % CR in DE. Common range: 0.7 to 0.95 | .9
useParallel = true;
verboseDE = true;

% Optional local refinement after DE. Keep false if you only want DE.
doLocalRefineAfterDE = false;
maxIterRefine = 500;
maxFunEvalsRefine = 2000;

rng('shuffle');

%% ================= BASIC FILE CHECKS =================
if ~isfile(csvFile)
    error('Cannot find %s. Put this script in the same folder as the CSV file.', csvFile);
end
if ~isfile('model.m')
    error('Cannot find model.m. Rename your model file to model.m and put it in this folder.');
end
if ~isfile('cost_function_2.m')
    error('Cannot find cost_function_2.m. Put it in this folder.');
end
if ~isfile('load_pars_Init_Copeland_Edited.m')
    error('Cannot find load_pars_Init_Copeland_Edited.m. Put it in this folder.');
end

%% ================= LOAD CSV DATA =================
opts = detectImportOptions(csvFile, 'TreatAsMissing', {'#DIV/0!', 'NaN', 'nan', ''});
T = readtable(csvFile, opts);

for j = 1:width(T)
    vname = T.Properties.VariableNames{j};
    col = T.(vname);
    if iscell(col) || isstring(col) || ischar(col)
        converted = str2double(string(col));
        if any(isfinite(converted))
            T.(vname) = converted;
        end
    end
end

timeAll = double(T.Time(:));

% Survivor_Data.csv uses Mean columns.
HR     = double(T.HR_Mean(:));    HRsd   = double(T.HR_SD(:));
TEMP   = double(T.TEMP_Mean(:));  TEMPsd = double(T.TEMP_SD(:));
TNF    = double(T.TNF_Mean(:));   TNFsd  = double(T.TNF_SD(:));
IL6    = double(T.IL_6_Mean(:));  IL6sd  = double(T.IL_6_SD(:));
IL8    = double(T.IL_8_Mean(:));  IL8sd  = double(T.IL_8_SD(:));

data = struct();
data.hr   = HR;
data.TNF  = TNF;
data.IL6  = IL6;
data.IL8  = IL8;
data.temp = TEMP;

%% ================= LOAD PARAMETERS AND INITIAL CONDITIONS =================
global ODE_TOL
ODE_TOL = 1e-6;

[pars, Init] = load_pars_Init_Copeland_Edited(data);

% ode23s should receive one consistent numeric type. MATLAB ODE solvers are
% most reliable in double precision, especially for stiff parameter fitting.
pars = double(pars(:));
Init = double(Init(:));

% Keep the original baseline separately for reference.
original_base_pars = pars;
original_base_Init = Init;

% Default starting point for this DE run.
base_pars = pars;
base_Init = Init;
startSource = 'original load_pars_Init_Copeland_Edited baseline';
previousBestCost = NaN;
previousInitialCost = NaN;

%% =====================================================================
% RESUME / CONTINUE FROM SAVED .MAT FILE
% =====================================================================
% If fit_de_results.mat exists, use the saved fitted values as the starting
% baseline for this new DE run. Then delta = 0 means the previous DE result.
% If no DE result exists and ALLOW_BAYESOPT_MAT_AS_FALLBACK_START = true,
% it can start from fit_bayesopt_results.mat instead.
[startMatFile, startMatWasFound] = chooseStartMatFile(matFile, fallbackBayesoptMatFile, ...
    LOAD_EXISTING_MAT_AS_START, ALLOW_BAYESOPT_MAT_AS_FALLBACK_START);

if startMatWasFound
    fprintf('\nFound existing %s. Loading saved fitted values as DE starting point...\n', startMatFile);
    Rprev = load(startMatFile);

    if isfield(Rprev, 'new_pars') && numel(Rprev.new_pars) == numel(base_pars)
        base_pars = double(Rprev.new_pars(:));
        startSource = sprintf('saved new_pars from %s', startMatFile);
    else
        warning('Existing mat file does not contain valid new_pars. Using original parameter baseline.');
    end

    if isfield(Rprev, 'new_Init') && numel(Rprev.new_Init) == numel(base_Init)
        base_Init = double(Rprev.new_Init(:));
        startSource = sprintf('%s and saved new_Init from %s', startSource, startMatFile);
    else
        warning('Existing mat file does not contain valid new_Init. Using original initial conditions.');
    end

    if isfield(Rprev, 'bestCost')
        previousBestCost = double(Rprev.bestCost(1));
    end
    if isfield(Rprev, 'initialCost')
        previousInitialCost = double(Rprev.initialCost(1));
    end

    fprintf('Starting source: %s\n', startSource);
    if isfinite(previousBestCost)
        fprintf('Previous saved best cost = %.6g\n', previousBestCost);
    end
else
    fprintf('\nNo existing mat file loaded. Starting from original baseline values.\n');
end

% Final precision guard. This is important because older fitted MAT files may
% contain new_pars and new_Init stored as single precision. Indexed assignment
% into a single array would keep the ODE initial conditions single and trigger
% the ode23s mixed single/double warning.
base_pars = double(base_pars(:));
base_Init = double(base_Init(:));
original_base_pars = double(original_base_pars(:));
original_base_Init = double(original_base_Init(:));

par_names = { ...
    'k10','k10m','k6','k6m','k8','k8m','ktnf','ktnfm','kma','kmpe', ...          % 1-10
    'kmr','kpe','x610','x66','x6tnf','x810','x8tnf','x106','xtnf10','xtnf6', ... % 11-20
    'xmpe','xm10','xmtnf','h106','h6tnf','h66','h610','h8tnf','h810','htnf10', ... % 21-30
    'htnf6','hm10','hmtnf','hmpe','stnf','s10','s8','s6','sm','mmax', ...       % 31-40
    'k6tnf','k8tnf','k106','kmtnf', ...                                        % 41-44
    'tau1','TM','Tm','kt','kttnf','kt6','kt10','xttnf','xt6','xt10', ...        % 45-54
    'httnf','ht6','ht10', ...                                                   % 55-57
    'tau2','HM','HI','kh','xht','hht', ...                                      % 58-63
    'ppM','kpepp','kpp', ...                                                    % 64-66
    'Ra','Rv','Rs','Cla','Csa','Clv','Csv','Em','EM', ...                       % 67-75
    'knom','kno','xntnf','xn10','hntnf','hn10', ...                             % 76-81
    'krpp','krno','kr','xrpp','hrpp','xhp','hhp', ...                           % 82-88
    'kpg','peinf','kpm','xI10','muno','kpn', ...                                % 89-94
    'kdn','mud','xdn','alpha','hmI10', ...                                      % 95-99
    'sM','kmp', ...                                                             % 100-101
    'kD','xDam','hmDa','xm10D','hm10D','hmD','knod','xnDl10','hnDl10','xn10D','hn10D','ktnfhr','BPo'}; % 102-114

if numel(par_names) ~= numel(pars)
    error('par_names has %d names, but pars has %d values.', numel(par_names), numel(pars));
end

parIndexTable = table((1:numel(base_pars))', par_names(:), base_pars(:), ...
    'VariableNames', {'Index','Parameter','StartingValue'});

fit_idx = [
    34;   %  1 hmpe
    76;   %  2 knom
    9;    %  3 kma
    91;   %  4 kpm
    98;   %  5 alpha
    97;   %  6 xdn
    100;  %  7 sM
    93;   %  8 muno
    21;   %  9 xmpe
    62;   % 10 xht
    % 39;   % 11 sm
    26;   % 12 h66
    % 107;  % 13 hmD
    % 14;   % 14 x66
    % 102;  % 15 kD
    % 20;   % 16 xtnf6
    % 81;   % 17 hn10
    % 95;   % 18 kdn
    % 7;    % 19 ktnf
    % 96;   % 20 mud
    % 77;   % 21 kno
    % 63;   % 22 hht
    89;   % 23 kpg
    % 31;   % 24 htnf6
    % 8;    % 25 ktnfm
    % 32;   % 26 hm10
    % 36;   % 27 s10
    48;   % 28 kt
    % 2;    % 29 k10m
    % 78;   % 30 xntnf
    % 79;   % 31 xn10
    % 1;    % 32 k10
    % 43;   % 33 k106
    % 61;   % 34 kh
    % 3;    % 35 k6
    % 19;   % 36 xtnf10
    % 45;   % 37 tau1
    % 4;    % 38 k6m
    % 94;   % 39 kpn
    % 22;   % 40 xm10
    % 80;   % 41 hntnf
    % 49;   % 42 kttnf
    87;   % 43 xhp
    % 41;   % 44 k6tnf
    % 5;    % 45 k8
    % 113;  % 46 ktnfhr
    % 42;   % 47 k8tnf
    % 101;  % 48 kmp
    % 64;   % 49 ppM
    % 50;   % 50 kt6
];
fit_idx = fit_idx(:);

% Initial condition index to fit.
% Init = [tnfI il10I il8I il6I maI mrI peI tempI ppI VlaI VsaI VlvI VsvI HI noI Rs DI]
% Therefore pathogen initial condition PE(0) is Init(7).
init_idx = 7;
init_names = {'PE_initial'};

morrisRank = (1:numel(fit_idx))';
fitTable = [table(morrisRank, 'VariableNames', {'MorrisRank'}), parIndexTable(fit_idx,:)];

disp('---------------- PARAMETERS BEING FIT ----------------');
disp(fitTable);

initFitTable = table(init_idx(:), init_names(:), base_Init(init_idx), ...
    'VariableNames', {'Index','InitialCondition','StartingValue'});

disp('---------------- INITIAL CONDITIONS BEING FIT ----------------');
disp(initFitTable);

%% ================= DATA USED IN OBJECTIVE FUNCTION =================
fitData = struct();
fitData.hr.time    = timeAll;
fitData.hr.mean    = HR;
fitData.hr.sd      = HRsd;
fitData.hr.state   = 14;
fitData.hr.name    = 'HR';

fitData.temp.time  = timeAll;
fitData.temp.mean  = TEMP;
fitData.temp.sd    = TEMPsd;
fitData.temp.state = 8;
fitData.temp.name  = 'Temperature';

fitData.tnf.time   = timeAll;
fitData.tnf.mean   = TNF;
fitData.tnf.sd     = TNFsd;
fitData.tnf.state  = 1;
fitData.tnf.name   = 'TNF';

fitData.il6.time   = timeAll;
fitData.il6.mean   = IL6;
fitData.il6.sd     = IL6sd;
fitData.il6.state  = 4;
fitData.il6.name   = 'IL-6';

fitData.il8.time   = timeAll;
fitData.il8.mean   = IL8;
fitData.il8.sd     = IL8sd;
fitData.il8.state  = 3;
fitData.il8.name   = 'IL-8';

% The cost function compares the model only at CSV/data times.
fitTimes = unique(timeAll(isfinite(timeAll)), 'sorted');
costTspan = double(unique([0; fitTimes(:); double(runningTime)], 'sorted'));
costTspan = costTspan(:);

%% ================= ADDITIVE DELTA BOUNDS =================
if perturbPercent > 1
    perturbFraction = perturbPercent/100;
else
    perturbFraction = perturbPercent;
end
perturbFraction = abs(perturbFraction);

%% ================= OBJECTIVE FUNCTION =================
nfitPar  = numel(fit_idx);
nfitInit = numel(init_idx);
nfit     = nfitPar + nfitInit;

% delta = additive changes for parameters followed by additive changes for ICs.
% delta = 0 means the current starting parameters and initial conditions.
initialDelta = zeros(nfit,1,'double');

% Build variable-specific additive bounds.
% Example: base value = 10 and perturbPercent = 20 gives delta in [-2, +2].
startingFitValues = double([base_pars(fit_idx); base_Init(init_idx)]);
deltaMax = perturbFraction .* abs(startingFitValues);

% If a selected value is exactly zero, allow a small default additive range.
% Adjust zeroValueAdditiveScale if you intentionally fit a zero-valued parameter/IC.
zeroValueAdditiveScale = 1;
zeroMask = deltaMax == 0;
deltaMax(zeroMask) = perturbFraction * zeroValueAdditiveScale;

lowerDelta = -deltaMax;
upperDelta =  deltaMax;

% Keep nonnegative starting values from crossing below zero.
nonnegativeStart = startingFitValues >= 0;
lowerDelta(nonnegativeStart) = max(lowerDelta(nonnegativeStart), -0.999999*startingFitValues(nonnegativeStart));

initialCost = cost_function_2(initialDelta, fit_idx, base_pars, base_Init, fitData, costTspan, useLogFit, perturbPercent, init_idx);
fprintf('\nInitial cost using starting parameters and initial conditions = %.6g\n', initialCost);

% Objective returns one scalar SSE value.
obj = @(delta) cost_function_2(delta, fit_idx, base_pars, base_Init, fitData, costTspan, useLogFit, perturbPercent, init_idx);

varNames = arrayfun(@(k) sprintf('delta%02d', k), 1:nfit, 'UniformOutput', false);

%% ================= DIFFERENTIAL EVOLUTION =================
if isempty(populationSize)
    populationSize = max(40, 4*nfit);
end
populationSize = max(populationSize, 4);
maxGenerations = ceil(max(0, maxObjectiveEvaluations - populationSize) / populationSize);

fprintf('\n================ DIFFERENTIAL EVOLUTION ================\n');
fprintf('Additive change bound: +/- %.2f%% of each starting value\n', 100*perturbFraction);
fprintf('Maximum objective evaluations: %d\n', maxObjectiveEvaluations);
fprintf('Population size: %d\n', populationSize);
fprintf('Maximum generations after initialization: %d\n', maxGenerations);
fprintf('Mutation factor F: %.3f\n', mutationFactor);
fprintf('Crossover rate CR: %.3f\n', crossoverRate);
fprintf('Fitted parameters: %d\n', nfitPar);
fprintf('Fitted initial conditions: %d\n', nfitInit);

[deResults, deOutput] = runDifferentialEvolution(obj, lowerDelta, upperDelta, initialDelta, ...
    populationSize, maxObjectiveEvaluations, mutationFactor, crossoverRate, ...
    useParallel, ODE_TOL, verboseDE, varNames);

delta_hat_raw = deResults.bestDelta(:);
delta_hat = clampAdditiveDelta(delta_hat_raw, lowerDelta, upperDelta);
bestCost = obj(delta_hat);
methodUsed = 'differential_evolution_additive_delta_parallel';
exitflag = NaN;
output = deOutput;
output.lowerDelta = lowerDelta;
output.upperDelta = upperDelta;
output.objectiveEvaluations = deResults.numObjectiveEvaluations;
results = deResults;

deEvaluationTable = deResults.evaluationTable;
deHistoryTable = deResults.historyTable;

fprintf('\nBest Differential Evolution cost = %.6g\n', bestCost);

%% ================= OPTIONAL LOCAL REFINEMENT =================
if doLocalRefineAfterDE
    fprintf('\n================ LOCAL REFINE AFTER DIFFERENTIAL EVOLUTION ================\n');
    refineOptions = optimset('Display','iter', ...
                             'MaxIter',maxIterRefine, ...
                             'MaxFunEvals',maxFunEvalsRefine, ...
                             'TolX',1e-12, ...
                             'TolFun',1e-12);

    [delta_refined_raw, cost_refined, exitflag_refine, output_refine] = fminsearch(obj, delta_hat, refineOptions);
    delta_refined = clampAdditiveDelta(delta_refined_raw, lowerDelta, upperDelta);
    cost_refined_checked = obj(delta_refined);

    if cost_refined_checked < bestCost
        delta_hat_raw = delta_refined_raw;
        delta_hat = delta_refined;
        bestCost = cost_refined_checked;
        methodUsed = 'differential_evolution_additive_delta_parallel_plus_fminsearch_refine';
        exitflag = exitflag_refine;
        output.fminsearchRefine = output_refine;
        output.fminsearchReportedCost = cost_refined;
        fprintf('Local refine improved cost to %.6g\n', bestCost);
    else
        fprintf('Local refine did not improve the Differential Evolution result.\n');
    end
end

%% ================= BUILD NEW PARAMETERS AND INITIAL CONDITIONS =================
delta_par  = delta_hat(1:nfitPar);
delta_init = delta_hat(nfitPar+1:end);

new_pars = base_pars;
new_pars(fit_idx) = base_pars(fit_idx) + delta_par;

new_Init = base_Init;
new_Init(init_idx) = base_Init(init_idx) + delta_init;

%% ================= PARAMETER RESULTS TABLE =================
idx = fit_idx(:);
paramNames = par_names(idx);
paramNames = paramNames(:);
oldVals = base_pars(idx);
newVals = new_pars(idx);
additiveDelta = newVals - oldVals;
percentChange = 100 * additiveDelta ./ oldVals;
percentChange(~isfinite(percentChange)) = NaN;
deltaBoundLower = lowerDelta(1:nfitPar);
deltaBoundUpper = upperDelta(1:nfitPar);
boundHit = abs(additiveDelta(:) - deltaBoundLower(:)) < 1e-12 | ...
           abs(additiveDelta(:) - deltaBoundUpper(:)) < 1e-12;

changedParams = table( ...
    idx, ...
    paramNames, ...
    oldVals, ...
    newVals, ...
    additiveDelta, ...
    percentChange, ...
    deltaBoundLower(:), ...
    deltaBoundUpper(:), ...
    boundHit(:), ...
    'VariableNames', {'Index','Parameter','OldValue','NewValue','AdditiveDelta','PercentChange','DeltaLowerBound','DeltaUpperBound','HitAdditiveBound'} ...
);

%% ================= INITIAL CONDITION RESULTS TABLE =================
initOldVals = base_Init(init_idx);
initNewVals = new_Init(init_idx);
initAdditiveDelta = initNewVals - initOldVals;
initPercentChange = 100 * initAdditiveDelta ./ initOldVals;
initPercentChange(~isfinite(initPercentChange)) = NaN;
initLowerDelta = lowerDelta(nfitPar+1:end);
initUpperDelta = upperDelta(nfitPar+1:end);
initBoundHit = abs(initAdditiveDelta(:) - initLowerDelta(:)) < 1e-12 | ...
               abs(initAdditiveDelta(:) - initUpperDelta(:)) < 1e-12;

changedInitialConditions = table( ...
    init_idx(:), ...
    init_names(:), ...
    initOldVals(:), ...
    initNewVals(:), ...
    initAdditiveDelta(:), ...
    initPercentChange(:), ...
    initLowerDelta(:), ...
    initUpperDelta(:), ...
    initBoundHit(:), ...
    'VariableNames', {'Index','InitialCondition','OldValue','NewValue','AdditiveDelta','PercentChange','DeltaLowerBound','DeltaUpperBound','HitAdditiveBound'} ...
);

%% ================= DISPLAY RESULTS =================
disp('---------------- FITTING RESULTS ----------------');
fprintf('Initial cost = %.6g\n', initialCost);
fprintf('Best cost = %.6g\n', bestCost);
fprintf('Method used = %s\n', methodUsed);

disp('---------------- CHANGED PARAMETERS ----------------');
disp(changedParams);

disp('---------------- CHANGED INITIAL CONDITIONS ----------------');
disp(changedInitialConditions);

%% ================= SAVE RESULTS =================
% Backup the previous mat file before overwriting it, so you do not lose the
% earlier fitted values when continuing optimization.
if BACKUP_EXISTING_MAT_BEFORE_SAVE && isfile(matFile)
    backupName = sprintf('fit_de_results_backup_%s.mat', datestr(now, 'yyyymmdd_HHMMSS'));
    copyfile(matFile, backupName);
    fprintf('\nBacked up previous mat file to: %s\n', backupName);
end

save(matFile, ...
    'base_pars', 'new_pars', 'fit_idx', 'par_names', ...
    'base_Init', 'new_Init', 'init_idx', 'init_names', ...
    'original_base_pars', 'original_base_Init', ...
    'startSource', 'previousBestCost', 'previousInitialCost', ...
    'delta_hat', 'delta_hat_raw', 'delta_par', 'delta_init', ...
    'lowerDelta', 'upperDelta', 'perturbPercent', 'bestCost', 'initialCost', ...
    'methodUsed', 'exitflag', 'output', ...
    'changedParams', 'changedInitialConditions', ...
    'deEvaluationTable', 'deHistoryTable', 'results');

writetable(changedParams, 'fit_de_changed_parameters.csv');
writetable(changedInitialConditions, 'fit_de_changed_initial_conditions.csv');
writetable(deEvaluationTable, 'fit_de_evaluations.csv');
writetable(deHistoryTable, 'fit_de_history.csv');

fprintf('\nSaved files:\n');
fprintf('  %s\n', matFile);
fprintf('  fit_de_changed_parameters.csv\n');
fprintf('  fit_de_changed_initial_conditions.csv\n');
fprintf('  fit_de_evaluations.csv\n');
fprintf('  fit_de_history.csv\n');
fprintf('\nUse fit_de_results.mat when comparing DE-fitted parameters against the baseline.\n');
totalElapsedSeconds = toc(totalTimer);
fprintf('\nTotal script runtime: %.2f seconds\n', totalElapsedSeconds);
fprintf('Total script runtime: %.2f minutes\n', totalElapsedSeconds/60);

%% ================= LOCAL FUNCTIONS =================
function [startMatFile, found] = chooseStartMatFile(matFile, fallbackMatFile, loadExisting, allowFallback)
    startMatFile = '';
    found = false;

    if ~loadExisting
        return
    end

    if isfile(matFile)
        startMatFile = matFile;
        found = true;
        return
    end

    if allowFallback && isfile(fallbackMatFile)
        startMatFile = fallbackMatFile;
        found = true;
    end
end

function [results, output] = runDifferentialEvolution(obj, lowerDelta, upperDelta, initialDelta, ...
    populationSize, maxObjectiveEvaluations, mutationFactor, crossoverRate, ...
    useParallel, odeTol, verboseDE, varNames)

    lowerDelta = double(lowerDelta(:));
    upperDelta = double(upperDelta(:));
    initialDelta = double(initialDelta(:));

    nVars = numel(initialDelta);
    span = upperDelta - lowerDelta;

    if any(span < 0)
        error('At least one upper bound is smaller than its lower bound.');
    end

    populationSize = max(populationSize, 4);
    populationSize = round(populationSize);
    maxObjectiveEvaluations = max(maxObjectiveEvaluations, populationSize);

    [useParallelNow, nWorkers] = setupParallelPool(useParallel);

    if verboseDE
        if useParallelNow
            fprintf('Parallel objective evaluation is ON with %d workers.\n', nWorkers);
        else
            fprintf('Parallel objective evaluation is OFF. Running serial objective evaluations.\n');
        end
    end

    % Initial population. The first member is exactly delta = 0 so the old
    % starting model is always included.
    pop = repmat(lowerDelta(:)', populationSize, 1) + rand(populationSize, nVars).*repmat(span(:)', populationSize, 1);
    pop(1,:) = initialDelta(:)';

    tic;
    costs = evaluateDeltaRows(pop, obj, useParallelNow, odeTol);
    numObjectiveEvaluations = populationSize;

    [bestCost, bestIdx] = min(costs);
    bestDelta = pop(bestIdx,:)';

    traceGeneration = zeros(populationSize,1);
    traceMember = (1:populationSize)';
    traceObjective = costs(:);
    traceAccepted = true(populationSize,1);
    traceDelta = pop;

    histGeneration = 0;
    histBestCost = bestCost;
    histMeanCost = mean(costs(isfinite(costs)));
    histNumEvals = numObjectiveEvaluations;

    generation = 0;

    while numObjectiveEvaluations < maxObjectiveEvaluations
        generation = generation + 1;
        nTrials = min(populationSize, maxObjectiveEvaluations - numObjectiveEvaluations);
        trials = zeros(nTrials, nVars);

        for i = 1:nTrials
            candidates = setdiff(1:populationSize, i);
            pick = candidates(randperm(numel(candidates), 3));
            r1 = pick(1);
            r2 = pick(2);
            r3 = pick(3);

            mutant = pop(r1,:) + mutationFactor*(pop(r2,:) - pop(r3,:));
            mutant = clampRow(mutant, lowerDelta, upperDelta);

            crossMask = rand(1,nVars) < crossoverRate;
            jrand = randi(nVars);
            crossMask(jrand) = true;

            trial = pop(i,:);
            trial(crossMask) = mutant(crossMask);
            trial = clampRow(trial, lowerDelta, upperDelta);
            trials(i,:) = trial;
        end

        trialCosts = evaluateDeltaRows(trials, obj, useParallelNow, odeTol);

        accepted = false(nTrials,1);
        for i = 1:nTrials
            if trialCosts(i) <= costs(i)
                pop(i,:) = trials(i,:);
                costs(i) = trialCosts(i);
                accepted(i) = true;
            end
        end

        numObjectiveEvaluations = numObjectiveEvaluations + nTrials;

        [currentBestCost, currentBestIdx] = min(costs);
        if currentBestCost < bestCost
            bestCost = currentBestCost;
            bestIdx = currentBestIdx;
            bestDelta = pop(bestIdx,:)';
        end

        traceGeneration = [traceGeneration; generation*ones(nTrials,1)]; %#ok<AGROW>
        traceMember = [traceMember; (1:nTrials)']; %#ok<AGROW>
        traceObjective = [traceObjective; trialCosts(:)]; %#ok<AGROW>
        traceAccepted = [traceAccepted; accepted(:)]; %#ok<AGROW>
        traceDelta = [traceDelta; trials]; %#ok<AGROW>

        histGeneration = [histGeneration; generation]; %#ok<AGROW>
        histBestCost = [histBestCost; bestCost]; %#ok<AGROW>
        histMeanCost = [histMeanCost; mean(costs(isfinite(costs)))]; %#ok<AGROW>
        histNumEvals = [histNumEvals; numObjectiveEvaluations]; %#ok<AGROW>

        if verboseDE
            fprintf('DE generation %4d | evals %6d/%6d | best cost %.6g | mean cost %.6g | accepted %d/%d\n', ...
                generation, numObjectiveEvaluations, maxObjectiveEvaluations, bestCost, ...
                histMeanCost(end), sum(accepted), nTrials);
        end
    end

    elapsedSeconds = toc;

    deltaTable = array2table(traceDelta, 'VariableNames', varNames);
    evaluationTable = [table(traceGeneration, traceMember, traceObjective, traceAccepted, ...
        'VariableNames', {'Generation','Member','Objective','Accepted'}), deltaTable];

    historyTable = table(histGeneration(:), histNumEvals(:), histBestCost(:), histMeanCost(:), ...
        'VariableNames', {'Generation','ObjectiveEvaluations','BestCost','MeanPopulationCost'});

    results = struct();
    results.bestDelta = bestDelta;
    results.bestCost = bestCost;
    results.bestMember = bestIdx;
    results.population = pop;
    results.populationCosts = costs;
    results.numObjectiveEvaluations = numObjectiveEvaluations;
    results.evaluationTable = evaluationTable;
    results.historyTable = historyTable;
    results.elapsedSeconds = elapsedSeconds;

    output = struct();
    output.algorithm = 'DE/rand/1/bin';
    output.populationSize = populationSize;
    output.maxObjectiveEvaluations = maxObjectiveEvaluations;
    output.mutationFactor = mutationFactor;
    output.crossoverRate = crossoverRate;
    output.useParallelRequested = useParallel;
    output.useParallelActual = useParallelNow;
    output.numWorkers = nWorkers;
    output.elapsedSeconds = elapsedSeconds;
end

function [useParallelNow, nWorkers] = setupParallelPool(useParallel)
    useParallelNow = false;
    nWorkers = 0;

    if ~useParallel
        return
    end

    try
        pool = gcp('nocreate');
        if isempty(pool)
            pool = parpool;
        end
        useParallelNow = true;
        nWorkers = pool.NumWorkers;
    catch ME
        warning('Could not start or use a parallel pool. Falling back to serial. Reason: %s', ME.message);
        useParallelNow = false;
        nWorkers = 0;
    end
end

function values = evaluateDeltaRows(deltaRows, obj, useParallelNow, odeTol)
    deltaRows = double(deltaRows);
    nRows = size(deltaRows,1);
    values = zeros(nRows,1,'double');

    if useParallelNow
        parfor i = 1:nRows
            values(i) = safeObjective(deltaRows(i,:)', obj, odeTol);
        end
    else
        for i = 1:nRows
            values(i) = safeObjective(deltaRows(i,:)', obj, odeTol);
        end
    end
end

function objectiveValue = safeObjective(delta, obj, odeTol)
    global ODE_TOL
    ODE_TOL = double(odeTol);
    delta = double(delta(:));

    try
        objectiveValue = obj(delta);
    catch
        objectiveValue = 1e20;
    end

    if isempty(objectiveValue) || ~isscalar(objectiveValue) || ~isfinite(objectiveValue)
        objectiveValue = 1e20;
    end
end

function row = clampRow(row, lowerDelta, upperDelta)
    row = min(max(double(row(:)), double(lowerDelta(:))), double(upperDelta(:)));
    row = row(:)';
end

function delta = clampAdditiveDelta(delta, lowerDelta, upperDelta)
    delta = double(delta(:));
    lowerDelta = double(lowerDelta(:));
    upperDelta = double(upperDelta(:));
    delta = min(max(delta, lowerDelta), upperDelta);
end
